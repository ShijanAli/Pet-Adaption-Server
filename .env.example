# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="Pet Adoption"
# Backend public URL (used for SSLCommerz callbacks & swagger)
SERVER_URL=http://localhost:5000
# Frontend URL(s), comma separated. Needed for CORS (cookies are cross-domain)
CLIENT_URLS=http://localhost:3000
# Frontend base URL used inside emails / payment redirects
CLIENT_URL=http://localhost:3000
# Staff schedules & booking times are in this timezone
BUSINESS_TIMEZONE=Asia/Dhaka

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_adoption?schema=public
# Used only by `npm test` (gets reset on every test run!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_adoption_test?schema=public

# ─── Auth ──────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token = opaque random token, stored hashed in DB, sent as httpOnly cookie
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
# Cookie domain — leave empty for host-only cookie
COOKIE_DOMAIN=
EMAIL_VERIFY_TOKEN_EXPIRES_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# ─── Brevo (email) ─────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_NAME="Pet Adoption"
EMAIL_FROM_ADDRESS=no-reply@example.com
# true => emails are logged, not sent (useful in dev/test)
EMAIL_DRY_RUN=true

# ─── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pet-adoption
UPLOAD_MAX_FILE_SIZE_MB=5

# ─── SSLCommerz (Phase 3) ──────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ─── Background jobs ─────────────────────────────────
# Expire unpaid bookings, clean old tokens. Safe with many instances (Postgres advisory lock)
JOBS_ENABLED=true
# Secret for GET /cron/jobs (lets an external cron run the jobs while a free server sleeps). Empty = disabled
CRON_SECRET=

# ─── Super admin seed ──────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=superadmin@petadoption.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Optional — where `npm run db:seed:demo` takes its photos from (default: ${CLIENT_URL}/images)
# DEMO_IMAGE_BASE_URL=https://your-frontend.com/images
